---
/**
 * Footer. One line, styled after the "Built with [heart] for Everyone at
 * Apple." pattern, adapted for a personal portfolio. The heart is a small
 * solid-red inline SVG (Heroicons' solid heart path), not a literal heart
 * emoji, per the brand's no-emoji voice rule (see corestratum/brand/identity.md,
 * anchor 4).
 */
import pkg from '../../package.json';
const version = pkg.version;
---

<footer class="px-6 py-16">
  <div class="max-w-2xl mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 text-sm text-ink-subtle border-t border-border pt-8">
    <p class="flex items-center gap-1.5">
      Built with
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="inline-block">
        <path
          d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"
          fill="#ef4444"
        />
      </svg>
      in the open.
    </p>
    <p>v{version}</p>
  </div>
</footer>
